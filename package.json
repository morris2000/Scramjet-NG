{
	"name": "scramjet-ng",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"test": "node --experimental-strip-types --test tests/runtime-adapter.test.ts tests/runtime-bootstrap.test.ts tests/runtime-official.test.ts tests/runtime-assets.test.ts tests/runtime-sync.test.ts tests/runtime-gateway.test.ts tests/runtime-composition.test.ts",
		"check": "node --experimental-strip-types --check runtime/adapter/adapter.ts",
		"check:official": "node --experimental-strip-types --check runtime/adapter/official.ts",
		"check:assets": "node --experimental-strip-types --check runtime/assets/server.ts",
		"check:sync": "node --experimental-strip-types --check runtime/assets/sync.ts",
		"check:gateway": "node --experimental-strip-types --check runtime/gateway/server.ts",
		"check:wisp": "node --experimental-strip-types --check runtime/gateway/wisp.ts",
		"check:composition": "node --experimental-strip-types --check runtime/composition/server.ts",
		"assets:sync": "node --experimental-strip-types runtime/assets/sync.ts",
		"e2e": "pnpm assets:sync && playwright test"
	},
	"dependencies": {
		"@mercuryworkshop/wisp-js": "0.4.1"
	},
	"devDependencies": {
		"@playwright/test": "1.62.0"
	}
}
